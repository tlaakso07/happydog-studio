# Local web configuration. Copy to .env.local and keep that file private.
# pnpm dev opens the sample beta without keys or sign-in.
# These settings are only needed for pnpm dev:live and authenticated deployments.
STUDIO_MODE=live
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing projects may use this instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
