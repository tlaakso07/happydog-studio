# Local web configuration. Copy to .env.local and keep that file private.
# Live is the default; preview is only for the existing sample walkthrough.
STUDIO_MODE=live
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing projects may use this instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
