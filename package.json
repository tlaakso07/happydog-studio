{
  "name": "happydog-studio",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs beta",
    "dev:beta": "node scripts/dev.mjs beta",
    "dev:live": "node scripts/dev.mjs live",
    "worker": "pnpm --filter @studio/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "db:types": "supabase gen types typescript --linked > packages/db/src/database.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
